{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "donordock-documents/content-blocks/pricing-card-purple/slots.schema.json",
  "title": "pricing-card-purple slot schema",
  "type": "object",
  "required": ["title", "highlight", "subtitle", "price", "included"],
  "additionalProperties": false,
  "properties": {
    "eyebrow": { "type": "string", "minLength": 4, "maxLength": 40 },
    "title": { "type": "string", "minLength": 4, "maxLength": 40 },
    "highlight": { "type": "string", "minLength": 4, "maxLength": 40 },
    "subtitle": { "type": "string", "minLength": 30, "maxLength": 240 },
    "price": {
      "type": "object",
      "required": ["amount", "period"],
      "properties": {
        "amount": { "type": "string", "minLength": 2, "maxLength": 15 },
        "period": { "type": "string", "minLength": 1, "maxLength": 20 },
        "billing_note": { "type": "string", "maxLength": 60 },
        "chips": {
          "type": "array",
          "minItems": 2,
          "maxItems": 5,
          "items": { "type": "string", "minLength": 4, "maxLength": 30 }
        }
      }
    },
    "included": {
      "type": "object",
      "required": ["title", "items"],
      "properties": {
        "title": { "type": "string", "minLength": 4, "maxLength": 40 },
        "items": {
          "type": "array",
          "minItems": 4,
          "maxItems": 12,
          "items": { "type": "string", "minLength": 8, "maxLength": 100 }
        }
      }
    },
    "sidebar": {
      "type": "object",
      "required": ["title"],
      "properties": {
        "title": { "type": "string", "minLength": 4, "maxLength": 50 },
        "body": { "type": "string", "minLength": 20, "maxLength": 280 },
        "items": {
          "type": "array",
          "minItems": 2,
          "maxItems": 6,
          "items": { "type": "string", "minLength": 8, "maxLength": 140 }
        }
      }
    },
    "guarantee": {
      "type": "object",
      "required": ["title", "body"],
      "properties": {
        "title": { "type": "string", "minLength": 4, "maxLength": 60 },
        "body": { "type": "string", "minLength": 20, "maxLength": 240 }
      }
    }
  }
}
