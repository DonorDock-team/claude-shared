{{!--
  onboarding-3phase — 3-column horizontal timeline of the 90-day onboarding
  arc: Setup → Activation → Growth. Closes with an outcomes checklist and an
  optional dark callout about ongoing support.

  Required slots: title, highlight, subtitle, phases, outcomes
  Optional slots: eyebrow (default "Onboarding & Migration"), support_callout
--}}
<div class="ob3-block">

  <div class="ob3-eyebrow">{{#if eyebrow}}{{eyebrow}}{{else}}Onboarding & Migration{{/if}}</div>

  <h2 class="ob3-title">
    {{title}}<br />
    <span class="highlight-purple">{{highlight}}</span>
  </h2>

  <p class="ob3-subtitle">{{subtitle}}</p>

  <div class="ob3-phase-grid">
    {{#each phases}}
    <div class="ob3-phase">
      <div class="ob3-phase-label">{{this.label}}</div>
      <h4 class="ob3-phase-name">{{this.name}}</h4>
      <p class="ob3-phase-body">{{this.body}}</p>
      {{#if this.closing}}
      <p class="ob3-phase-closing">{{this.closing}}</p>
      {{/if}}
      <div class="ob3-phase-result">
        <strong>{{this.result}}</strong>
      </div>
    </div>
    {{/each}}
  </div>

  <div class="ob3-outcomes">
    <h4 class="ob3-outcomes-title">{{outcomes.title}}</h4>
    <ul class="ob3-outcomes-list">
      {{#each outcomes.items}}
      <li><span class="ob3-check">✓</span><span>{{this}}</span></li>
      {{/each}}
    </ul>
  </div>

  {{#if support_callout}}
  <div class="ob3-support">
    <strong>{{support_callout.title}}</strong> {{support_callout.body}}
  </div>
  {{/if}}

</div>

<style>
  .ob3-block { padding-top: var(--space-lg); }
  .ob3-eyebrow {
    display: inline-flex; align-items: center;
    padding: 0.375rem 0.875rem;
    background: #FFEDD5;
    color: var(--orange);
    border-radius: var(--radius-pill);
    font-size: var(--type-label-size);
    font-weight: var(--type-label-weight);
    letter-spacing: var(--type-label-tracking);
    text-transform: uppercase;
  }
  .ob3-title { margin-top: var(--space-md); color: var(--text-primary); }
  .ob3-subtitle {
    margin-top: var(--space-sm);
    color: var(--text-secondary);
    max-width: 65ch;
  }
  .ob3-phase-grid {
    display: grid;
    grid-template-columns: 1fr 1fr 1fr;
    gap: var(--space-md);
    margin-top: var(--space-lg);
  }
  .ob3-phase {
    display: flex;
    flex-direction: column;
  }
  .ob3-phase-label {
    font-size: var(--type-overline-size);
    font-weight: 700;
    letter-spacing: var(--type-label-tracking);
    text-transform: uppercase;
    color: var(--brand-purple);
  }
  .ob3-phase-name {
    margin-top: 0.25rem;
    color: var(--text-primary);
    font-size: 1.25rem;
    font-weight: 700;
  }
  .ob3-phase-body {
    margin-top: var(--space-xs);
    color: var(--text-secondary);
    font-size: var(--type-small-size);
    line-height: 1.5;
  }
  .ob3-phase-closing {
    margin-top: var(--space-xs);
    color: var(--text-tertiary);
    font-size: var(--type-small-size);
    line-height: 1.5;
  }
  .ob3-phase-result {
    margin-top: var(--space-sm);
    padding: var(--space-sm);
    background: var(--bg-light-purple);
    border: 1px solid rgba(0, 0, 0, 0.06);
    border-radius: var(--radius-sm);
    box-shadow: var(--shadow-sm);
    color: var(--brand-purple);
    font-size: var(--type-small-size);
    line-height: 1.4;
  }
  .ob3-outcomes {
    margin-top: var(--space-lg);
  }
  .ob3-outcomes-title {
    font-size: 1rem;
    font-weight: 700;
    color: var(--text-primary);
    margin-bottom: var(--space-sm);
  }
  .ob3-outcomes-list {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: var(--space-xs) var(--space-md);
  }
  .ob3-outcomes-list li {
    display: flex;
    gap: var(--space-xs);
    color: var(--text-secondary);
    font-size: var(--type-small-size);
    line-height: 1.5;
  }
  .ob3-check {
    color: var(--brand-purple);
    font-weight: 700;
    flex: 0 0 auto;
  }
  .ob3-support {
    margin-top: var(--space-lg);
    padding: var(--space-md);
    background: var(--brand-blue);
    color: var(--text-inverse);
    border-radius: var(--radius-md);
    font-size: var(--type-small-size);
    line-height: 1.5;
  }
  .ob3-support strong { color: var(--text-inverse); }
</style>
