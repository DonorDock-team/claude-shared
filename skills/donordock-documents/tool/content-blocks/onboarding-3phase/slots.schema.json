{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "donordock-documents/content-blocks/onboarding-3phase/slots.schema.json",
  "title": "onboarding-3phase slot schema",
  "type": "object",
  "required": ["title", "highlight", "subtitle", "phases", "outcomes"],
  "additionalProperties": false,
  "properties": {
    "eyebrow": { "type": "string", "minLength": 4, "maxLength": 40 },
    "title": { "type": "string", "minLength": 4, "maxLength": 40 },
    "highlight": { "type": "string", "minLength": 4, "maxLength": 50 },
    "subtitle": { "type": "string", "minLength": 40, "maxLength": 320 },
    "phases": {
      "type": "array",
      "minItems": 3,
      "maxItems": 3,
      "items": {
        "type": "object",
        "required": ["label", "name", "body", "result"],
        "properties": {
          "label": { "type": "string", "minLength": 8, "maxLength": 40 },
          "name": { "type": "string", "minLength": 3, "maxLength": 20 },
          "body": { "type": "string", "minLength": 60, "maxLength": 400 },
          "closing": { "type": "string", "minLength": 10, "maxLength": 160 },
          "result": { "type": "string", "minLength": 10, "maxLength": 120 }
        }
      }
    },
    "outcomes": {
      "type": "object",
      "required": ["title", "items"],
      "properties": {
        "title": { "type": "string", "minLength": 4, "maxLength": 60 },
        "items": {
          "type": "array",
          "minItems": 4,
          "maxItems": 8,
          "items": { "type": "string", "minLength": 8, "maxLength": 100 }
        }
      }
    },
    "support_callout": {
      "type": "object",
      "required": ["title", "body"],
      "properties": {
        "title": { "type": "string", "minLength": 8, "maxLength": 60 },
        "body": { "type": "string", "minLength": 30, "maxLength": 280 }
      }
    }
  }
}
