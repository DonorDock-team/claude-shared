{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "donordock-documents/content-blocks/why-donordock-stats/slots.schema.json",
  "title": "why-donordock-stats slot schema",
  "type": "object",
  "required": ["title", "highlight", "subtitle", "stats", "narrative"],
  "additionalProperties": false,
  "properties": {
    "eyebrow": { "type": "string", "minLength": 4, "maxLength": 30 },
    "title": { "type": "string", "minLength": 4, "maxLength": 40 },
    "highlight": { "type": "string", "minLength": 4, "maxLength": 40 },
    "subtitle": { "type": "string", "minLength": 30, "maxLength": 280 },
    "stats": {
      "type": "array",
      "minItems": 4,
      "maxItems": 4,
      "items": {
        "type": "object",
        "required": ["value", "label"],
        "properties": {
          "value": { "type": "string", "minLength": 1, "maxLength": 60 },
          "label": { "type": "string", "minLength": 4, "maxLength": 60 },
          "accent": { "type": "string", "enum": ["blue", "green", "yellow", "orange", "purple"] }
        }
      }
    },
    "narrative": {
      "type": "object",
      "required": ["title", "paragraphs"],
      "properties": {
        "title": { "type": "string", "minLength": 8, "maxLength": 60 },
        "paragraphs": {
          "type": "array",
          "minItems": 1,
          "maxItems": 3,
          "items": { "type": "string", "minLength": 60, "maxLength": 400 }
        }
      }
    },
    "context_card": {
      "type": "object",
      "required": ["title", "items"],
      "properties": {
        "title": { "type": "string", "minLength": 8, "maxLength": 50 },
        "items": {
          "type": "array",
          "minItems": 2,
          "maxItems": 6,
          "items": { "type": "string", "minLength": 8, "maxLength": 100 }
        }
      }
    },
    "recognition": {
      "type": "object",
      "required": ["title", "badges"],
      "properties": {
        "title": { "type": "string", "minLength": 4, "maxLength": 40 },
        "badges": {
          "type": "array",
          "minItems": 4,
          "maxItems": 4,
          "items": { "type": "string", "minLength": 4, "maxLength": 28 }
        }
      }
    },
    "quote": {
      "type": "object",
      "required": ["text", "attribution"],
      "properties": {
        "text": { "type": "string", "minLength": 40, "maxLength": 360 },
        "attribution": { "type": "string", "minLength": 4, "maxLength": 80 }
      }
    }
  }
}
