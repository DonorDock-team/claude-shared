{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "donordock-documents/content-blocks/before-after-chips/slots.schema.json",
  "title": "before-after-chips slot schema",
  "type": "object",
  "required": ["today", "after"],
  "additionalProperties": false,
  "properties": {
    "today": {
      "type": "object",
      "required": ["label", "items"],
      "properties": {
        "label": { "type": "string", "minLength": 4, "maxLength": 30 },
        "items": {
          "type": "array",
          "minItems": 3,
          "maxItems": 8,
          "items": {
            "type": "object",
            "required": ["text"],
            "properties": {
              "text": { "type": "string", "minLength": 2, "maxLength": 30 },
              "kept": { "type": "boolean" }
            }
          }
        }
      }
    },
    "today_footnote": { "type": "string", "minLength": 10, "maxLength": 160 },
    "after": {
      "type": "object",
      "required": ["label", "items"],
      "properties": {
        "label": { "type": "string", "minLength": 4, "maxLength": 30 },
        "items": {
          "type": "array",
          "minItems": 3,
          "maxItems": 10,
          "items": { "type": "string", "minLength": 2, "maxLength": 24 }
        }
      }
    },
    "after_footnote": { "type": "string", "minLength": 10, "maxLength": 160 }
  }
}
