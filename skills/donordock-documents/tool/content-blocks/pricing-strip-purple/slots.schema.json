{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "donordock-documents/content-blocks/pricing-strip-purple/slots.schema.json",
  "title": "pricing-strip-purple slot schema",
  "type": "object",
  "required": ["price", "included"],
  "additionalProperties": false,
  "properties": {
    "price": {
      "type": "object",
      "required": ["amount", "period"],
      "properties": {
        "amount": { "type": "string", "minLength": 2, "maxLength": 15 },
        "period": { "type": "string", "minLength": 1, "maxLength": 20 },
        "billing_note": { "type": "string", "maxLength": 60 }
      }
    },
    "chips": {
      "type": "array",
      "minItems": 2,
      "maxItems": 4,
      "items": { "type": "string", "minLength": 4, "maxLength": 30 }
    },
    "included": {
      "type": "array",
      "minItems": 4,
      "maxItems": 8,
      "items": { "type": "string", "minLength": 8, "maxLength": 60 }
    },
    "footnote": {
      "type": "object",
      "required": ["title", "body"],
      "properties": {
        "title": { "type": "string", "minLength": 4, "maxLength": 30 },
        "body": { "type": "string", "minLength": 10, "maxLength": 120 }
      }
    }
  }
}
