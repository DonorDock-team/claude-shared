{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "donordock-documents/content-blocks/tool-consolidation/slots.schema.json",
  "title": "tool-consolidation slot schema",
  "type": "object",
  "required": ["title", "highlight", "subtitle", "today", "with_donordock"],
  "additionalProperties": false,
  "properties": {
    "eyebrow": { "type": "string", "minLength": 4, "maxLength": 30 },
    "title": { "type": "string", "minLength": 4, "maxLength": 40 },
    "highlight": { "type": "string", "minLength": 4, "maxLength": 40 },
    "subtitle": { "type": "string", "minLength": 60, "maxLength": 360 },
    "today": {
      "type": "object",
      "required": ["title", "items"],
      "properties": {
        "title": { "type": "string", "minLength": 4, "maxLength": 50 },
        "items": {
          "type": "array",
          "minItems": 3,
          "maxItems": 5,
          "items": {
            "type": "object",
            "required": ["name", "body"],
            "properties": {
              "name": { "type": "string", "minLength": 2, "maxLength": 50 },
              "body": { "type": "string", "minLength": 20, "maxLength": 200 }
            }
          }
        },
        "callout": {
          "type": "object",
          "required": ["title", "body"],
          "properties": {
            "title": { "type": "string", "minLength": 4, "maxLength": 40 },
            "body": { "type": "string", "minLength": 30, "maxLength": 240 }
          }
        }
      }
    },
    "with_donordock": {
      "type": "object",
      "required": ["title", "items"],
      "properties": {
        "title": { "type": "string", "minLength": 4, "maxLength": 60 },
        "items": {
          "type": "array",
          "minItems": 3,
          "maxItems": 5,
          "items": {
            "type": "object",
            "required": ["name", "body"],
            "properties": {
              "name": { "type": "string", "minLength": 2, "maxLength": 60 },
              "body": { "type": "string", "minLength": 20, "maxLength": 240 }
            }
          }
        },
        "callout": {
          "type": "object",
          "required": ["title", "body"],
          "properties": {
            "title": { "type": "string", "minLength": 4, "maxLength": 40 },
            "body": { "type": "string", "minLength": 30, "maxLength": 240 }
          }
        }
      }
    }
  }
}
