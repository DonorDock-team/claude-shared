{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "donordock-documents/content-blocks/your-moment/slots.schema.json",
  "title": "your-moment slot schema",
  "type": "object",
  "required": ["title", "highlight", "subtitle", "where_you_are", "what_you_need"],
  "additionalProperties": false,
  "properties": {
    "eyebrow": {
      "type": "string",
      "minLength": 4,
      "maxLength": 24,
      "description": "Uppercased label above the heading. Default 'Your Moment'."
    },
    "title": {
      "type": "string",
      "minLength": 4,
      "maxLength": 60,
      "description": "First line of the heading."
    },
    "highlight": {
      "type": "string",
      "minLength": 2,
      "maxLength": 40,
      "description": "Highlighted phrase that ends the heading."
    },
    "subtitle": {
      "type": "string",
      "minLength": 60,
      "maxLength": 360,
      "description": "1-2 sentence framing."
    },
    "where_you_are": {
      "type": "object",
      "required": ["title", "items"],
      "properties": {
        "title": { "type": "string", "minLength": 4, "maxLength": 40 },
        "items": {
          "type": "array",
          "minItems": 2,
          "maxItems": 4,
          "items": {
            "type": "object",
            "required": ["heading", "body"],
            "properties": {
              "heading": { "type": "string", "minLength": 4, "maxLength": 60 },
              "body": { "type": "string", "minLength": 30, "maxLength": 260 }
            }
          }
        }
      }
    },
    "what_you_need": {
      "type": "object",
      "required": ["title", "items"],
      "properties": {
        "title": { "type": "string", "minLength": 4, "maxLength": 50 },
        "items": {
          "type": "array",
          "minItems": 5,
          "maxItems": 9,
          "items": { "type": "string", "minLength": 4, "maxLength": 80 }
        }
      }
    },
    "quote": {
      "type": "object",
      "required": ["text", "attribution"],
      "properties": {
        "text": { "type": "string", "minLength": 30, "maxLength": 280 },
        "attribution": { "type": "string", "minLength": 4, "maxLength": 80 }
      }
    }
  }
}
