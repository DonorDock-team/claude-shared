{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "donordock-documents/content-blocks/limited-time-offer-sidebar/slots.schema.json",
  "title": "limited-time-offer-sidebar slot schema",
  "type": "object",
  "required": ["title", "body"],
  "additionalProperties": false,
  "properties": {
    "title": { "type": "string", "minLength": 4, "maxLength": 40 },
    "body": { "type": "string", "minLength": 30, "maxLength": 280 },
    "footnote": { "type": "string", "minLength": 20, "maxLength": 280 },
    "variant": { "type": "string", "enum": ["default", "yellow"] }
  }
}
