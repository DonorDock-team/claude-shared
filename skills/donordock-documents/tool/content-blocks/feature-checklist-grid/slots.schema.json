{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "donordock-documents/content-blocks/feature-checklist-grid/slots.schema.json",
  "title": "feature-checklist-grid slot schema",
  "type": "object",
  "required": ["items"],
  "additionalProperties": false,
  "properties": {
    "title": { "type": "string", "minLength": 4, "maxLength": 50 },
    "columns": { "type": "integer", "enum": [3, 4, 5] },
    "items": {
      "type": "array",
      "minItems": 6,
      "maxItems": 15,
      "items": {
        "type": "object",
        "required": ["label"],
        "properties": {
          "label": { "type": "string", "minLength": 2, "maxLength": 28 },
          "accent": { "type": "string", "enum": ["purple", "blue", "green", "orange", "yellow", "coral"] }
        }
      }
    }
  }
}
