{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "donordock-documents/content-blocks/cover-purple/slots.schema.json",
  "title": "cover-purple slot schema",
  "description": "Validates the data shape consumed by cover-purple/template.hbs",
  "type": "object",
  "required": ["prepared_for", "headline", "highlight", "subtitle", "meta"],
  "additionalProperties": false,
  "properties": {
    "prepared_for": {
      "type": "string",
      "minLength": 2,
      "maxLength": 60,
      "description": "Prospect/customer name shown in the top-right badge."
    },
    "headline": {
      "type": "string",
      "minLength": 5,
      "maxLength": 60,
      "description": "First line of the cover headline."
    },
    "highlight": {
      "type": "string",
      "minLength": 5,
      "maxLength": 60,
      "description": "Second line of the headline — rendered with the cream-chip highlight backdrop."
    },
    "subtitle": {
      "type": "string",
      "minLength": 60,
      "maxLength": 320,
      "description": "2-3 sentence summary of what this document is."
    },
    "chips": {
      "type": "array",
      "minItems": 3,
      "maxItems": 8,
      "items": {
        "type": "string",
        "minLength": 2,
        "maxLength": 24,
        "description": "Capability pill — short label, ideally under 20 chars."
      }
    },
    "meta": {
      "type": "object",
      "required": ["left", "center", "right"],
      "additionalProperties": false,
      "properties": {
        "left": {
          "type": "string",
          "maxLength": 40,
          "description": "Bottom-left meta — typically donordock.com"
        },
        "center": {
          "type": "string",
          "maxLength": 40,
          "description": "Bottom-center meta — typically Month Year"
        },
        "right": {
          "type": "string",
          "maxLength": 80,
          "description": "Bottom-right meta — typically Prepared by <name> · <email>"
        }
      }
    },
    "badge_label": {
      "type": "string",
      "minLength": 4,
      "maxLength": 40,
      "description": "Override for the top-right badge. Use for non-proposal cases like 'Evaluation Overview' or 'Partnership Proposal'."
    }
  }
}
