{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "donordock-documents/content-blocks/platform-overview-quad/slots.schema.json",
  "title": "platform-overview-quad slot schema",
  "type": "object",
  "required": ["title", "highlight", "subtitle", "quadrants"],
  "additionalProperties": false,
  "properties": {
    "eyebrow": { "type": "string", "minLength": 4, "maxLength": 30 },
    "title": { "type": "string", "minLength": 4, "maxLength": 40 },
    "highlight": { "type": "string", "minLength": 4, "maxLength": 40 },
    "subtitle": { "type": "string", "minLength": 40, "maxLength": 320 },
    "quadrants": {
      "type": "array",
      "minItems": 4,
      "maxItems": 4,
      "items": {
        "type": "object",
        "required": ["title", "accent", "items"],
        "properties": {
          "title": { "type": "string", "minLength": 4, "maxLength": 40 },
          "accent": { "type": "string", "enum": ["blue", "green", "yellow", "orange", "purple"] },
          "items": {
            "type": "array",
            "minItems": 4,
            "maxItems": 7,
            "items": { "type": "string", "minLength": 8, "maxLength": 120 }
          }
        }
      }
    },
    "footnote": {
      "type": "object",
      "required": ["title", "body"],
      "properties": {
        "title": { "type": "string", "minLength": 8, "maxLength": 80 },
        "body": { "type": "string", "minLength": 20, "maxLength": 200 }
      }
    }
  }
}
