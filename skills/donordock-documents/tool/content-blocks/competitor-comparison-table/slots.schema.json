{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "donordock-documents/content-blocks/competitor-comparison-table/slots.schema.json",
  "title": "competitor-comparison-table slot schema",
  "type": "object",
  "required": ["competitors", "rows"],
  "additionalProperties": false,
  "properties": {
    "caption": { "type": "string", "minLength": 4, "maxLength": 40 },
    "competitors": {
      "type": "array",
      "minItems": 1,
      "maxItems": 3,
      "items": { "type": "string", "minLength": 2, "maxLength": 24 }
    },
    "rows": {
      "type": "array",
      "minItems": 2,
      "maxItems": 5,
      "items": {
        "type": "object",
        "required": ["dimension", "donordock_value", "competitor_values"],
        "properties": {
          "dimension": { "type": "string", "minLength": 2, "maxLength": 24 },
          "donordock_value": { "type": "string", "minLength": 4, "maxLength": 80 },
          "competitor_values": {
            "type": "array",
            "minItems": 1,
            "maxItems": 3,
            "items": { "type": "string", "minLength": 4, "maxLength": 60 }
          }
        }
      }
    }
  }
}
