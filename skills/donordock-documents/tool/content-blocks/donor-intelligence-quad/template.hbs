{{!--
  donor-intelligence-quad — 4-card grid showcasing donor data capabilities:
  Contact Profiles / Otto AI / Pipelines / Automations. Each card has a
  colored accent, optional paragraph intro, optional bullet list, and an
  optional nested grid of mini-pills (used for Automations).

  Required slots: title, highlight, subtitle, cards
  Optional slots: eyebrow (default "Donor Intelligence")
--}}
<div class="diq-block">

  <div class="diq-eyebrow">{{#if eyebrow}}{{eyebrow}}{{else}}Donor Intelligence{{/if}}</div>

  <h2 class="diq-title">
    {{title}}<br />
    <span class="highlight-purple">{{highlight}}</span>
  </h2>

  <p class="diq-subtitle">{{subtitle}}</p>

  <div class="diq-grid">
    {{#each cards}}
    <div class="diq-card diq-card--{{this.accent}}">
      <h4 class="diq-card-title">{{this.title}}</h4>
      {{#if this.body}}<p class="diq-card-body">{{this.body}}</p>{{/if}}
      {{#if this.items}}
      <ul class="diq-card-list">
        {{#each this.items}}
        <li><span class="diq-arrow">→</span><span>{{this}}</span></li>
        {{/each}}
      </ul>
      {{/if}}
      {{#if this.mini_cards}}
      <div class="diq-mini-grid">
        {{#each this.mini_cards}}
        <div class="diq-mini diq-mini--{{this.accent}}">
          <div class="diq-mini-label">{{this.label}}</div>
          <div class="diq-mini-body">{{this.body}}</div>
        </div>
        {{/each}}
      </div>
      {{/if}}
    </div>
    {{/each}}
  </div>

</div>

<style>
  .diq-block { padding-top: var(--space-lg); }
  .diq-eyebrow {
    display: inline-flex; align-items: center;
    padding: 0.375rem 0.875rem;
    background: var(--brand-purple-light);
    color: var(--brand-purple);
    border-radius: var(--radius-pill);
    font-size: var(--type-label-size);
    font-weight: var(--type-label-weight);
    letter-spacing: var(--type-label-tracking);
    text-transform: uppercase;
  }
  .diq-title { margin-top: var(--space-md); color: var(--text-primary); }
  .diq-subtitle {
    margin-top: var(--space-sm);
    color: var(--text-secondary);
    max-width: 60ch;
  }
  .diq-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: var(--space-md);
    margin-top: var(--space-lg);
  }
  .diq-card {
    padding: var(--space-md);
    border-radius: var(--radius-md);
    border: 1px solid rgba(0, 0, 0, 0.06);
    background: var(--bg-white);
    box-shadow: var(--shadow-md);
  }
  .diq-card--blue   { background: #EFF6FF;                }
  .diq-card--green  { background: var(--green-light);     }
  .diq-card--yellow { background: var(--yellow-light);    }
  .diq-card--orange { background: #FFF7ED;                }
  .diq-card--purple { background: var(--bg-light-purple); }
  .diq-card-title {
    font-size: 1.125rem;
    font-weight: 700;
    margin-bottom: var(--space-xs);
  }
  .diq-card--blue   .diq-card-title { color: var(--brand-blue);   }
  .diq-card--green  .diq-card-title { color: var(--green);        }
  .diq-card--yellow .diq-card-title { color: #B45309;             }
  .diq-card--orange .diq-card-title { color: var(--orange);       }
  .diq-card--purple .diq-card-title { color: var(--brand-purple); }
  .diq-card-body {
    color: var(--text-secondary);
    font-size: var(--type-small-size);
    line-height: 1.5;
    margin-bottom: var(--space-sm);
  }
  .diq-card-list {
    display: flex;
    flex-direction: column;
    gap: 0.4rem;
  }
  .diq-card-list li {
    display: flex;
    gap: var(--space-xs);
    color: var(--text-secondary);
    font-size: var(--type-small-size);
    line-height: 1.5;
  }
  .diq-arrow {
    color: inherit;
    flex: 0 0 auto;
    opacity: 0.7;
  }
  .diq-mini-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: var(--space-xs);
    margin-top: var(--space-sm);
  }
  .diq-mini {
    padding: var(--space-sm);
    border-radius: var(--radius-sm);
  }
  .diq-mini--external { background: #FFEDD5; }
  .diq-mini--internal { background: #FED7AA; }
  .diq-mini--data     { background: var(--brand-purple-light); }
  .diq-mini-label {
    font-size: var(--type-overline-size);
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    margin-bottom: 0.25rem;
  }
  .diq-mini--external .diq-mini-label { color: var(--orange); }
  .diq-mini--internal .diq-mini-label { color: #C2410C; }
  .diq-mini--data     .diq-mini-label { color: var(--brand-purple); }
  .diq-mini-body {
    font-size: 0.75rem;
    line-height: 1.4;
    color: var(--text-secondary);
  }
</style>
