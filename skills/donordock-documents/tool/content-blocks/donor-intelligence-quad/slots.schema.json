{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "donordock-documents/content-blocks/donor-intelligence-quad/slots.schema.json",
  "title": "donor-intelligence-quad slot schema",
  "type": "object",
  "required": ["title", "highlight", "subtitle", "cards"],
  "additionalProperties": false,
  "properties": {
    "eyebrow": { "type": "string", "minLength": 4, "maxLength": 30 },
    "title": { "type": "string", "minLength": 4, "maxLength": 40 },
    "highlight": { "type": "string", "minLength": 4, "maxLength": 40 },
    "subtitle": { "type": "string", "minLength": 40, "maxLength": 320 },
    "cards": {
      "type": "array",
      "minItems": 4,
      "maxItems": 4,
      "items": {
        "type": "object",
        "required": ["title", "accent"],
        "properties": {
          "title": { "type": "string", "minLength": 4, "maxLength": 50 },
          "accent": { "type": "string", "enum": ["blue", "green", "yellow", "orange", "purple"] },
          "body": { "type": "string", "minLength": 30, "maxLength": 280 },
          "items": {
            "type": "array",
            "minItems": 3,
            "maxItems": 6,
            "items": { "type": "string", "minLength": 8, "maxLength": 120 }
          },
          "mini_cards": {
            "type": "array",
            "minItems": 3,
            "maxItems": 3,
            "items": {
              "type": "object",
              "required": ["label", "body", "accent"],
              "properties": {
                "label": { "type": "string", "minLength": 3, "maxLength": 20 },
                "body": { "type": "string", "minLength": 20, "maxLength": 120 },
                "accent": { "type": "string", "enum": ["external", "internal", "data"] }
              }
            }
          }
        }
      }
    }
  }
}
