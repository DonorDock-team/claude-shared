{{!--
  next-steps-numbered — closing page. 3-step numbered call-to-action with
  a dark contact card at the bottom containing the rep's name, role, email,
  website, and a CTA button.

  Required slots: title, highlight, subtitle, steps, contact
  Optional slots: eyebrow (default "Next Steps")
--}}
<div class="nsn-block">

  <div class="nsn-eyebrow">{{#if eyebrow}}{{eyebrow}}{{else}}Next Steps{{/if}}</div>

  <h2 class="nsn-title">
    {{title}}<br />
    <span class="highlight-purple">{{highlight}}</span>
  </h2>

  <p class="nsn-subtitle">{{subtitle}}</p>

  <ol class="nsn-steps">
    {{#each steps}}
    <li class="nsn-step">
      <div class="nsn-step-num"></div>
      <div class="nsn-step-body">
        <h4 class="nsn-step-heading">{{this.heading}}</h4>
        <p class="nsn-step-text">{{this.body}}</p>
      </div>
    </li>
    {{/each}}
  </ol>

  <div class="nsn-contact">
    <div class="nsn-contact-left">
      <div class="nsn-contact-name">{{contact.name}}</div>
      <div class="nsn-contact-role">{{contact.role}}</div>
      <div class="nsn-contact-meta">
        <div>{{contact.email}}</div>
        {{#if contact.website}}<div>{{contact.website}}</div>{{/if}}
      </div>
    </div>
    <div class="nsn-contact-right">
      {{#if contact.cta_message}}<div class="nsn-cta-msg">{{contact.cta_message}}</div>{{/if}}
      <a class="nsn-cta-btn">{{contact.cta_label}}</a>
    </div>
  </div>

</div>

<style>
  .nsn-block { padding-top: var(--space-lg); }
  .nsn-eyebrow {
    display: inline-flex; align-items: center;
    padding: 0.375rem 0.875rem;
    background: var(--brand-purple-light);
    color: var(--brand-purple);
    border-radius: var(--radius-pill);
    font-size: var(--type-label-size);
    font-weight: var(--type-label-weight);
    letter-spacing: var(--type-label-tracking);
    text-transform: uppercase;
  }
  .nsn-title { margin-top: var(--space-md); color: var(--text-primary); }
  .nsn-subtitle {
    margin-top: var(--space-sm);
    color: var(--text-secondary);
    max-width: 65ch;
  }
  .nsn-steps {
    margin-top: var(--space-lg);
    display: flex;
    flex-direction: column;
    gap: 0;
    counter-reset: step;
  }
  .nsn-step {
    display: flex;
    gap: var(--space-md);
    padding: var(--space-md) 0;
    border-bottom: 1px solid var(--border-light);
    counter-increment: step;
  }
  .nsn-step:last-child { border-bottom: none; }
  .nsn-step-num {
    flex: 0 0 auto;
    width: 36px;
    height: 36px;
    border-radius: 50%;
    background: var(--brand-purple);
    color: var(--text-inverse);
    display: flex;
    align-items: center;
    justify-content: center;
    font-weight: 700;
  }
  .nsn-step-num::before {
    content: counter(step);
  }
  .nsn-step-heading {
    font-size: 1.125rem;
    font-weight: 700;
    color: var(--text-primary);
  }
  .nsn-step-text {
    margin-top: 0.25rem;
    color: var(--text-secondary);
    font-size: var(--type-small-size);
    line-height: 1.6;
  }
  .nsn-contact {
    margin-top: var(--space-lg);
    padding: var(--space-md) var(--space-lg);
    background: var(--brand-purple);
    color: var(--text-inverse);
    border-radius: var(--radius-md);
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: var(--space-md);
  }
  .nsn-contact-name {
    font-size: 1.25rem;
    font-weight: 700;
    color: var(--text-inverse);
  }
  .nsn-contact-role {
    margin-top: 0.125rem;
    color: var(--text-on-dark);
    font-size: var(--type-small-size);
  }
  .nsn-contact-meta {
    margin-top: var(--space-xs);
    color: var(--text-on-dark);
    font-size: var(--type-small-size);
    line-height: 1.5;
  }
  .nsn-contact-right {
    text-align: right;
  }
  .nsn-cta-msg {
    color: var(--text-on-dark);
    font-size: var(--type-small-size);
    margin-bottom: var(--space-xs);
  }
  .nsn-cta-btn {
    display: inline-block;
    padding: 0.625rem 1.25rem;
    background: var(--bg-cream);
    color: var(--brand-purple);
    border-radius: var(--radius-pill);
    font-weight: 700;
    font-size: 0.95rem;
  }
</style>
