{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "donordock-documents/content-blocks/next-steps-numbered/slots.schema.json",
  "title": "next-steps-numbered slot schema",
  "type": "object",
  "required": ["title", "highlight", "subtitle", "steps", "contact"],
  "additionalProperties": false,
  "properties": {
    "eyebrow": { "type": "string", "minLength": 4, "maxLength": 30 },
    "title": { "type": "string", "minLength": 4, "maxLength": 40 },
    "highlight": { "type": "string", "minLength": 2, "maxLength": 30 },
    "subtitle": { "type": "string", "minLength": 40, "maxLength": 320 },
    "steps": {
      "type": "array",
      "minItems": 3,
      "maxItems": 3,
      "items": {
        "type": "object",
        "required": ["heading", "body"],
        "properties": {
          "heading": { "type": "string", "minLength": 8, "maxLength": 80 },
          "body": { "type": "string", "minLength": 40, "maxLength": 400 }
        }
      }
    },
    "contact": {
      "type": "object",
      "required": ["name", "role", "email", "cta_label"],
      "properties": {
        "name": { "type": "string", "minLength": 4, "maxLength": 50 },
        "role": { "type": "string", "minLength": 8, "maxLength": 80 },
        "email": { "type": "string", "minLength": 6, "maxLength": 80 },
        "website": { "type": "string", "minLength": 4, "maxLength": 80 },
        "cta_message": { "type": "string", "minLength": 8, "maxLength": 80 },
        "cta_label": { "type": "string", "minLength": 4, "maxLength": 30 }
      }
    }
  }
}
